# Переменные окружения timetable-service — справочник. Файл .env не нужен: стек запускается
# `docker compose up --build` со значениями по умолчанию из docker-compose.yml (`${VAR:-default}`),
# код читает те же имена (src/app/settings.py). Чтобы переопределить значения локально, скопируйте
# файл в .env (он в .gitignore): его читают и docker compose, и just (`set dotenv-load`).
# Значения ниже совпадают со значениями по умолчанию в docker-compose.yml.

# --- Приложение (контейнер app) -----------------------------------------------------------------
# DSN PostgreSQL (SQLAlchemy async, драйвер asyncpg). Изнутри compose хост — postgres.
DATABASE_URL=postgresql+asyncpg://wa:wa@postgres:5432/wa
# Брокер приложения — RabbitMQ. По умолчанию Compose использует те же значения.
BROKER=rabbitmq
# Адрес RabbitMQ изнутри Compose:
BROKER_URL=amqp://wa:wa@rabbitmq:5672/
# Базовый URL заглушки соседнего сервиса.
STUB_BASE_URL=http://people-stub:8100
# Таймаут одного вызова заглушки, мс.
STUB_TIMEOUT_MS=2000
# 1 — доступны /__test/*, периодические задачи отключены (так работают e2e); 0 — боевой режим.
TEST_MODE=1
# 1 — загрузить seed при старте контейнера (после миграций). E2e сами вызывают POST /__test/reset.
SEED_ON_START=0
# Интервал фоновых задач при TEST_MODE=0, с (1..60).
JOBS_INTERVAL_SECONDS=30
# Уровень логирования: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Команды с хоста (just) ---------------------------------------------------------------------
# DSN для `just migration` (alembic autogenerate с хоста; порт PostgreSQL опубликован).
HOST_DATABASE_URL=postgresql+asyncpg://wa:wa@localhost:5432/wa
# Адреса стека для `just e2e-public`.
E2E_BASE_URL=http://localhost:8000
E2E_STUB_URL=http://localhost:8100
# Брокер для e2e определяется автоматически по открытому порту (5672 — RabbitMQ, 9092 — Kafka);
# задайте явно, если подняты оба: BROKER=kafka и E2E_BROKER_URL=localhost:9092.
# E2E_BROKER_URL=amqp://wa:wa@localhost:5672/
